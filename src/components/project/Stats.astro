---
// Row of key numbers. Same look on every project page.
interface Stat {
  value: string;
  label: string;
}

interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

<div class="stats grid grid-cols-2 gap-4" style={`--n:${items.length}`}>
  {
    items.map((s) => (
      <div class="pj-card p-5">
        <p class="text-2xl md:text-3xl font-semibold text-[var(--sec)] tabular-nums leading-tight">{s.value}</p>
        <p class="mt-2 text-xs md:text-sm text-[var(--white-icon)] leading-snug">{s.label}</p>
      </div>
    ))
  }
</div>

<style>
  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }
</style>
