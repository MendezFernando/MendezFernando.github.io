---
import { Image } from "astro:assets";

interface Project {
  title: string;
  // optional: while there is no screenshot, a placeholder with the tech stack is shown
  image?: ImageMetadata;
  // GitHub repository
  repo: string;
  // project page inside this portfolio (optional)
  page?: string;
  status: string;
  description?: string;
  stack?: string[];
}

// Add your projects here (import the image at the top, like: import myImg from "../../public/my.png";)
const projects: Project[] = [
  {
    title: "Pharma Commercial Analytics Hub",
    repo: "https://github.com/MendezFernando/pharma-analytics-hub-case-study",
    page: "/projects/pharma-analytics-hub",
    status: "Case study · Professional work",
    description:
      "Replaced a 6–8 hour monthly process with a system that ingests four pharmaceutical market audits, validates them with severity-aware rules and publishes every report in ~20 minutes. Matches the raw vendor data 100%.",
    stack: ["Python", "pandas", "Excel", "xlsxwriter", "TOML", "CLI", "Automated tests"],
  },
  {
    title: "E-commerce Data Platform (Olist)",
    repo: "https://github.com/MendezFernando/marketplace-data-platform",
    status: "Personal project, 2026",
    description:
      "End-to-end medallion lakehouse over the real Olist dataset: idempotent ingestion to partitioned Parquet, a PySpark + Delta Lake Silver layer, a Kimball star schema with SCD Type 2, and a dbt semantic layer with 30 data tests.",
    stack: ["Python", "PySpark", "Delta Lake", "dbt", "PostgreSQL", "Docker", "Airflow", "MinIO (S3)"],
  },
  {
    title: "Medical Sample Allocation",
    repo: "https://github.com/MendezFernando/medical-sample-allocation",
    page: "/projects/medical-sample-allocation",
    status: "Econometric study · Pharma",
    description:
      "Separates the causal effect of free drug samples from sales-force targeting bias on physician-level data (2.36M observations), and turns it into a budget-neutral allocation model projecting +54.9% incremental prescriptions.",
    stack: ["Python", "Fixed effects", "PSM", "LightGBM", "SHAP", "pandas"],
  },
];

const btn =
  "size-12 sm:size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]";
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    {projects.length === 0 && (
      <p class="text-[var(--white-icon)]">Projects coming soon.</p>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => {
          // main link: the portfolio page if there is one, otherwise the repo
          const main = project.page ?? project.repo;
          const external = !project.page;
          return (
            <article class="group flex flex-col">
              <a
                href={main}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="block rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4"
                aria-label={`Open ${project.title}`}
              >
                {project.image ? (
                  <Image
                    src={project.image}
                    alt={project.title}
                    class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-48 md:h-72 flex flex-wrap content-center justify-center gap-2 p-6 bg-gradient-to-br from-[#241a38] to-[#101010] border border-[var(--white-icon-tr)] rounded-2xl group-hover:border-[#a476ff60] transition-colors">
                    {project.stack?.map((tech) => (
                      <span class="text-xs sm:text-sm px-3 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)] bg-[#1414149c]">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </a>
              <div class="flex items-start gap-3 px-3">
                <div class="flex-grow min-w-0">
                  <h4 class="text-xl sm:text-2xl font-semibold">
                    <a href={main} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="hover:text-white">
                      {project.title}
                    </a>
                  </h4>
                  <span class="py-1 text-sm text-[var(--white-icon)]">
                    {project.status}
                  </span>
                  {project.description && (
                    <p class="mt-2 text-sm text-[var(--white-icon)]">
                      {project.description}
                    </p>
                  )}
                </div>
                <div class="flex gap-2 shrink-0">
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title} on GitHub`}
                    title="Repository"
                    class={btn}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 sm:size-7">
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                    </svg>
                  </a>
                  {project.page && (
                    <a
                      href={project.page}
                      aria-label={`${project.title} project page`}
                      title="Project page"
                      class={btn}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 sm:size-7">
                        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/MendezFernando?tab=repositories"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
