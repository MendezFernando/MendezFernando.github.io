---
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import Section from "@/components/project/Section.astro";
import Stats from "@/components/project/Stats.astro";

// Content only: no client, product or file names — the system belongs to the employer.
const stats = [
  { value: "~20 min", label: "per monthly cycle, down from 6–8 hours" },
  { value: "<0.01%", label: "difference vs. the reports already published" },
  { value: "100%", label: "match against the raw vendor file" },
  { value: "1 cmd", label: "to run the full monthly cycle end to end" },
];

const pains = [
  { issue: "Each audit named the same product differently", effect: "Reports never reconciled" },
  { issue: "Joins were done by name", effect: "A rename broke them silently" },
  { issue: "Validation meant eyeballing", effect: "Errors surfaced after sending" },
  { issue: "6–8 hours per cycle", effect: "A workday a month on mechanics" },
];

const sources = [
  "National sales by pack",
  "Sales by fine geographic zone",
  "Institutional channel",
  "Medical prescriptions",
];

const steps = [
  { n: "01", title: "Ingest", text: "Reads every audit, including fixed-width files of ~1M lines." },
  { n: "02", title: "Normalize", text: "Names, periods and nomenclature against single catalogs." },
  { n: "03", title: "Compute", text: "Rolling year, YTD, market share, evolution and penetration indices." },
  { n: "04", title: "Validate", text: "Explicit rules, each one blocking, for review, or informative." },
  { n: "05", title: "Deliver", text: "Excel reports with one format across every deliverable." },
];

const checks = [
  { v: "stop", label: "STOP", text: "Duplicated quotas in one zone" },
  { v: "stop", label: "STOP", text: "Weighted market with no quota" },
  { v: "rev", label: "REV", text: "Packs missing from this delivery" },
  { v: "rev", label: "REV", text: "Market name differs across sources" },
  { v: "ok", label: "OK", text: "No duplicate sales keys" },
  { v: "ok", label: "OK", text: "Allocation preserves totals" },
  { v: "ok", label: "OK", text: "Matches raw vendor file" },
];

const decisions = [
  {
    title: "Join by code, never by name",
    text: "The same product arrives spelled three ways depending on the audit, but with the same code. Several historical errors came from name joins that broke silently after a rename.",
  },
  {
    title: "Catalogs as the single source of truth",
    text: "Official names, aliases and composite markets live in tables the business edits. A new consolidated market is one row, not a code change.",
  },
  {
    title: "Derive instead of capture",
    text: "Statuses that used to be maintained by hand in Excel are now computed every month. What is captured goes stale; what is derived does not.",
  },
  {
    title: "History instead of recalculation",
    text: "Commercial weights change month to month. Each period's weights are stored, so a past month reproduces exactly as it was published.",
  },
  {
    title: "Severity-aware validation",
    text: "It tells apart a market that is truly missing from one spelled differently in another source — two problems with different fixes that used to look identical.",
  },
  {
    title: "Documentation that never goes stale",
    text: "The layout of every input and output is generated from the real files and is stable across months. If it changes, a vendor changed the format.",
  },
];

const beforeAfter = [
  { aspect: "Time per cycle", before: "6–8 hours of manual work", after: "~20 min of runtime, plus reviewing findings" },
  { aspect: "Validation", before: "By eye, at the end", after: "Automatic, with a verdict before publishing" },
  { aspect: "Consistency", before: "Different names and formats per report", after: "One nomenclature everywhere" },
  { aspect: "Handover", before: "Depended on one person", after: "Step-by-step manual and checklist" },
];

const findings = [
  { tag: "Silent", text: "Two columns published as zero for months — a default value hid that the field was never read." },
  { tag: "Silent", text: "Duplicated quotas summed without warning, inflating targets and sinking reported attainment." },
  { tag: "Double count", text: "A consolidated market counted twice alongside its own components." },
  { tag: "Broken join", text: "Packs that stopped matching their market after a product rename." },
  { tag: "Environment", text: "Code that worked on one machine and failed on another due to library version differences." },
];

const lessons = [
  { title: "A normal-looking number isn't validated.", text: "The costliest errors raised no alerts." },
  { title: "Validate against the raw source.", text: "Matching the old process only proves you copied its bugs." },
  { title: "Fewer layers, fewer exceptions.", text: "Every simplification made it easier to run for someone who didn't build it." },
];
---

<ProjectLayout
  slug="pharma-analytics-hub"
  eyebrow="Case study · Commercial data engineering"
  heading='From a full workday to <span class="text-[var(--sec)]">20 minutes</span>'
  lede="I replaced a 6–8 hour monthly process — notebooks, loose scripts and eyeball checks — with a system that processes four pharmaceutical market audits, builds every report and validates it before anything ships."
  sections={[
    { id: "result", label: "Result" },
    { id: "problem", label: "Problem" },
    { id: "how", label: "How it works" },
    { id: "architecture", label: "Architecture" },
    { id: "findings", label: "Findings" },
    { id: "lessons", label: "Lessons" },
  ]}
>
  <div slot="note" class="pj-note">
    <p class="lab">Confidentiality</p>
    <p>The system belongs to the company where I built it. No code or data here — just the problem, the design and the results.</p>
  </div>

  <Stats items={stats} />

  <Section id="result" eyebrow="Result" title="A workday now fits in a coffee break">
    <div class="pj-card p-6 md:p-8 space-y-5" role="img" aria-label="Drawn to scale: before 6 to 8 hours, after about 20 minutes">
      <div class="bar-row">
        <span class="text-sm text-[var(--white-icon)]">Before</span>
        <div class="track"><div class="fill before"></div><div class="fill range"></div></div>
        <span class="font-mono text-right">6–8 h</span>
      </div>
      <div class="bar-row">
        <span class="text-sm text-[var(--white-icon)]">After</span>
        <div class="track"><div class="fill after"></div></div>
        <span class="font-mono text-right text-[var(--sec)]">~20 min</span>
      </div>
      <div class="bar-row">
        <span></span>
        <div class="flex justify-between font-mono text-xs text-[var(--white-icon)]"><span>0</span><span>2h</span><span>4h</span><span>6h</span><span>8h</span></div>
        <span></span>
      </div>
    </div>
  </Section>

  <Section
    id="problem"
    eyebrow="The problem"
    title="A process that grew by accumulation"
    intro="Every month, the commercial team of a global pharmaceutical company receives market audits from an external vendor. They feed the reports used by the sales force, marketing and leadership. The process lived in notebooks and scripts, and the order of execution lived in one person's head."
  >
    <ul class="grid sm:grid-cols-2 gap-4">
      {
        pains.map((p) => (
          <li class="pj-card p-5 border-l-2" style="border-left-color: var(--sec)">
            <p class="font-semibold">{p.issue}</p>
            <p class="text-sm text-[var(--white-icon)] mt-1">{p.effect}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="how" eyebrow="How it works" title="From four raw audits to a verdict">
    <div class="flow">
      <div class="sources">
        <p class="mini-label">Monthly audits</p>
        {
          sources.map((s) => (
            <div class="source">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5 shrink-0" aria-hidden="true"><path d="M6 2h9l5 5v15H6z"></path><path d="M15 2v5h5"></path></svg>
              <span>{s}</span>
            </div>
          ))
        }
        <div class="source catalog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5 shrink-0" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"></path></svg>
          <span>Business catalogs</span>
        </div>
      </div>

      <div class="connector" aria-hidden="true"><span></span></div>

      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <div>
                <p class="font-semibold">{s.title}</p>
                <p class="text-sm text-[var(--white-icon)]">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="connector" aria-hidden="true"><span></span></div>

      <div class="gate">
        <div class="gate-node">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-7" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"></path><path d="m8.5 12 2.5 2.5 4.5-5"></path></svg>
          <p class="font-semibold">Verdict</p>
        </div>
        <div class="branch ok-branch">
          <span class="v ok">PASS</span>
          <p>Reports published</p>
        </div>
        <div class="branch stop-branch">
          <span class="v stop">STOP</span>
          <p>Findings report, nothing ships</p>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 items-center mt-12">
      <div>
        <h4 class="pj-sub mt-0">Every monthly run ends in a verdict</h4>
        <p class="pj-text">
          Before a single report ships, the hub checks the month's data against explicit rules.
          Blocking findings stop the release; everything else goes to review with its evidence.
        </p>
      </div>
      <figure class="pj-card overflow-hidden font-mono text-sm" aria-label="Example validation report">
        <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--white-icon-tr)]">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="size-3 rounded-full bg-[#ff5f57]"></span>
            <span class="size-3 rounded-full bg-[#febc2e]"></span>
            <span class="size-3 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="text-xs text-[var(--white-icon)]">$ hub validate --month</span>
        </div>
        <ul class="p-4 space-y-2">
          {
            checks.map((c) => (
              <li class="grid grid-cols-[3.5rem_1fr] gap-2">
                <span class={`v ${c.v}`}>{c.label}</span>
                <span>{c.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="px-4 py-3 border-t border-[var(--white-icon-tr)] flex items-center gap-3">
          <span class="text-[var(--white-icon)]">Verdict</span>
          <span class="verdict">DO NOT PUBLISH</span>
        </div>
      </figure>
    </div>
  </Section>

  <Section
    id="architecture"
    eyebrow="Architecture"
    title="Three layers, not five"
    intro="I started with the full medallion pattern and removed the layers that didn't separate anything real. The boundary that matters here isn't bronze/silver/gold — it's computed (CSV anyone can open and audit) versus delivered (formatted Excel for the end user)."
  >
    <div class="layers">
      <div class="pj-card layer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-7" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4z"></path><path d="M3 12l9 4 9-4M3 17l9 4 9-4"></path></svg>
        <p class="font-semibold">Landing</p>
        <p class="text-sm text-[var(--white-icon)]">Files as received. Never edited.</p>
      </div>
      <div class="layer-arrow" aria-hidden="true">→</div>
      <div class="pj-card layer hot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path></svg>
        <p class="font-semibold">Computed</p>
        <p class="text-sm text-[var(--white-icon)]">Clean, joined, auditable CSV.</p>
      </div>
      <div class="layer-arrow" aria-hidden="true">→</div>
      <div class="layer-split">
        <div class="pj-card layer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-7" aria-hidden="true"><path d="M6 2h9l5 5v15H6z"></path><path d="M15 2v5h5M9 13h6M9 17h4"></path></svg>
          <p class="font-semibold">Deliverables</p>
          <p class="text-sm text-[var(--white-icon)]">Formatted Excel reports.</p>
        </div>
        <div class="pj-card layer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-7" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
          <p class="font-semibold">Evidence</p>
          <p class="text-sm text-[var(--white-icon)]">Validations and findings.</p>
        </div>
      </div>
    </div>

    <h4 class="pj-sub">Design decisions</h4>
    <div class="grid md:grid-cols-2 gap-4">
      {
        decisions.map((d) => (
          <article class="pj-card p-6">
            <p class="text-lg font-semibold mb-2">{d.title}</p>
            <p class="text-sm text-[var(--white-icon)]">{d.text}</p>
          </article>
        ))
      }
    </div>

    <h4 class="pj-sub">Before and after</h4>
    <div class="pj-table">
      <table>
        <thead>
          <tr><th></th><th>Before</th><th class="!text-[var(--sec)]">After</th></tr>
        </thead>
        <tbody>
          {
            beforeAfter.map((r) => (
              <tr>
                <td class="font-semibold">{r.aspect}</td>
                <td class="muted">{r.before}</td>
                <td>{r.after}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section id="findings" eyebrow="What it caught" title="Errors that produced perfectly believable numbers">
    <ul class="space-y-3">
      {
        findings.map((f) => (
          <li class="pj-card flex flex-col sm:flex-row sm:items-center gap-3 px-5 py-4">
            <span class="pj-tag shrink-0">{f.tag}</span>
            <p class="text-[var(--white-icon)]">{f.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="lessons" eyebrow="Lessons" title="What I'd tell anyone building the next one">
    <div class="grid md:grid-cols-3 gap-4">
      {
        lessons.map((l) => (
          <div class="lesson">
            <p class="font-semibold text-lg">{l.title}</p>
            <p class="text-sm text-[var(--white-icon)]">{l.text}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-10 text-sm text-[var(--white-icon)]">Case study without code or data. Validation examples use generic wording.</p>
  </Section>
</ProjectLayout>

<style>
  .v { font-family: ui-monospace, Consolas, monospace; font-weight: 700; }
  .v.ok { color: #6fdc9c; }
  .v.rev { color: #f3c25b; }
  .v.stop { color: #ff7a70; }
  .verdict {
    font-family: ui-monospace, Consolas, monospace; font-size: .75rem; font-weight: 700;
    letter-spacing: .06em; color: #ff7a70; background: #ff7a7018;
    border: 1px solid #ff7a7040; padding: .25rem .6rem; border-radius: 999px;
  }

  /* time bars, drawn to an 8h scale */
  .bar-row { display: grid; grid-template-columns: 4.5rem 1fr 5.5rem; gap: 1rem; align-items: center; }
  .track { position: relative; height: 1.1rem; border-radius: 999px; background: #ffffff0d; overflow: hidden; }
  .fill { position: absolute; inset-block: 0; left: 0; }
  .fill.before { width: 75%; background: #6b6b6b; }
  .fill.range { left: 75%; width: 25%; background: repeating-linear-gradient(135deg, #6b6b6b 0 5px, transparent 5px 10px); }
  .fill.after { width: 4.17%; background: var(--sec); box-shadow: 0 0 16px #a476ff90; border-radius: 999px; }

  /* pipeline flow */
  .flow { display: grid; grid-template-columns: 1fr 2.5rem 1.35fr 2.5rem 1fr; align-items: center; }
  .mini-label { font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; color: var(--white-icon); margin-bottom: .6rem; }
  .sources { display: grid; gap: .5rem; }
  .source { display: flex; gap: .6rem; align-items: center; font-size: .85rem; padding: .6rem .75rem; border-radius: .75rem; border: 1px solid var(--white-icon-tr); background: #1414149c; color: var(--white-icon); }
  .source.catalog { border-style: dashed; border-color: #a476ff60; color: var(--white); margin-top: .35rem; }
  .connector { position: relative; height: 2px; }
  .connector span { position: absolute; inset: 0; background: linear-gradient(90deg, #a476ff00, #a476ff); }
  .connector span::after { content: ""; position: absolute; right: -2px; top: -4px; border: 5px solid transparent; border-left-color: #a476ff; }
  .steps { list-style: none; display: grid; position: relative; }
  .steps::before { content: ""; position: absolute; left: 1.2rem; top: 1.2rem; bottom: 1.2rem; width: 2px; background: linear-gradient(#a476ff, #a476ff30); }
  .step { display: grid; grid-template-columns: 2.4rem 1fr; gap: .9rem; padding: .55rem 0; position: relative; }
  .step-n { width: 2.4rem; height: 2.4rem; border-radius: 999px; display: grid; place-items: center; font-size: .75rem; font-weight: 700; color: var(--background); background: var(--sec); box-shadow: 0 0 0 5px var(--background); }
  .gate { display: grid; gap: .6rem; }
  .gate-node { display: flex; align-items: center; gap: .6rem; padding: .8rem 1rem; border-radius: 1rem; border: 1px solid #a476ff80; background: #241a38; color: var(--white); }
  .branch { border-radius: .75rem; border: 1px solid var(--white-icon-tr); background: #1414149c; padding: .7rem .9rem; display: grid; gap: .15rem; font-size: .85rem; color: var(--white-icon); }
  .ok-branch { border-left: 3px solid #6fdc9c; }
  .stop-branch { border-left: 3px solid #ff7a70; }

  /* layers */
  .layers { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: .75rem; align-items: center; }
  .layer { padding: 1.1rem; display: grid; gap: .3rem; color: var(--white-icon); }
  .layer svg { margin-bottom: .3rem; }
  .layer p.font-semibold { color: var(--white); }
  .layer.hot { border-color: #a476ff90; background: linear-gradient(135deg, #241a38, #141414); color: var(--sec); }
  .layer-arrow { color: var(--sec); font-size: 1.4rem; }
  .layer-split { display: grid; gap: .75rem; }

  .lesson { border-top: 2px solid var(--sec); padding-top: 1rem; display: grid; gap: .4rem; }

  @media (max-width: 900px) {
    .flow { grid-template-columns: 1fr; gap: 1rem; }
    .connector { height: 2rem; width: 2px; justify-self: center; }
    .connector span { background: linear-gradient(#a476ff00, #a476ff); }
    .connector span::after { right: -4px; top: auto; bottom: -8px; border-left-color: transparent; border-top-color: #a476ff; }
    .layers { grid-template-columns: 1fr; }
    .layer-arrow { transform: rotate(90deg); justify-self: center; }
  }
  @media (max-width: 480px) {
    .bar-row { grid-template-columns: 3.5rem 1fr 4.5rem; gap: .6rem; }
  }
</style>
